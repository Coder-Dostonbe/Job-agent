# Telegram bot that delivers the daily report (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Telegram API credentials, from https://my.telegram.org -> API development tools
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash

# Telethon session string, produced by: python create_session_qr.py
# Needed to read public Telegram channels. Keep it secret.
TG_SESSION_STRING=

# Optional. Without it the agent still runs, but the AI filter and AI scoring
# are skipped. From https://console.anthropic.com
ANTHROPIC_API_KEY=

# PostgreSQL connection string for the history of already-reported vacancies.
# Required for scheduled runs: a GitHub Actions runner is wiped after every run,
# so a local file cannot survive. Any hosted Postgres works (Neon, Supabase, ...).
# postgresql://user:password@host/dbname
DATABASE_URL=

# Fallback used only when DATABASE_URL is empty — a local SQLite file.
DB_PATH=vacancies.db
